# ── Ollama Connection ─────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# ── Model Selection ───────────────────────────────────────────────────────────
# Change to qwen2.5:0.5b on 4 GB RAM machines
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_FAST_MODEL=llama3.2:1b
OLLAMA_FALLBACK_MODEL=qwen2.5:0.5b

# ── CPU Optimization ──────────────────────────────────────────────────────────
# Critical — prevents disk swapping on laptops
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m
